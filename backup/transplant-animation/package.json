{
  "name": "@topocode/topo-animation",
  "version": "1.0.0",
  "description": "A pure frontend animation engine for architecture visualization and algorithm teaching",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "unpkg": "./dist/index.umd.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rollup -c rollup.config.mjs",
    "build:examples": "vite build --config vite.examples.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test:run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "pixi.js": "^7.4.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "rollup": "^4.34.0",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vitest": "^3.0.0",
    "jsdom": "^26.0.0"
  },
  "peerDependencies": {
    "d3": "^7.9.0",
    "pixi.js": "^7.4.3"
  },
  "keywords": [
    "animation",
    "topology",
    "visualization",
    "algorithm",
    "teaching",
    "d3",
    "pixijs",
    "svg",
    "canvas"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/topocode/topo-animation.git"
  }
}
