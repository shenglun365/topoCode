{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["architect-src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["architect-src/**/*.ts", "architect-src/**/*.d.ts", "architect-src/**/*.vue", "entry-architect.ts"],
  "references": [{ "path": "./architect.tsconfig.node.json" }]
}
