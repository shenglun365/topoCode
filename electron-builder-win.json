{
  "electronDist": null,
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "backend-core/**/*"
  ],
  "extraResources": [
    {
      "from": "backend-core",
      "to": "backend-core",
      "filter": ["**/*"]
    },
    {
      "from": "dist-plugins",
      "to": "plugins",
      "filter": ["**/*"]
    },
    {
      "from": "dist-modules",
      "to": "modules",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": null,
    "sign": null,
    "certificateSubjectName": null,
    "certificateSha1": null
  },
  "linux": {
    "target": ["AppImage", "deb"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": null,
    "uninstallerIcon": null,
    "installerHeaderIcon": null,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "TopoCode UI"
  },
  "afterPack": "./build/afterPack.cjs"
}
